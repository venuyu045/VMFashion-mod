{
  "schemaVersion": 1,
  "id": "vmfashion",
  "version": "${version}",
  "name": "Venus Mc Fashion",
  "description": "Client-side cosmetics for Minecraft: wear Blockbench / Bedrock 3D outfits (capes, wings, hats, back items, pets) on your character, and optionally sync them with a web wardrobe. Pure client mod — the server needs nothing installed.",
  "authors": [
    "Venus"
  ],
  "contact": {
    "homepage": "https://github.com/venuyu045/VMFashion-mod",
    "sources": "https://github.com/venuyu045/VMFashion-mod",
    "issues": "https://github.com/venuyu045/VMFashion-mod/issues"
  },
  "license": "MIT",
  "icon": "assets/vmfashion/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.venus.vmfashion.VMFashionClient"
    ]
  },
  "mixins": [
    "vmfashion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.0",
    "geckolib": ">=5.5.7"
  }
}
